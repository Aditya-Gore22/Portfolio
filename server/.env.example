# Server Configuration
PORT=5000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=portfolio_db

# Security & JWT Token Key
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Admin Credentials (used on first seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_FULL_NAME=Your Name
ADMIN_EMAIL=your_email@example.com

# Site Settings Configuration
SITE_TITLE=Your Name | Full Stack Developer Portfolio
ADMIN_TAGLINE=Full Stack Web Developer
ADMIN_QUOTE=Build. Improve. Repeat.
CONTACT_EMAIL=your_email@example.com
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-username
PORTFOLIO_URL=https://your-portfolio.dev
